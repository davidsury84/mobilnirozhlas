var QUIZ = [
 {q:"Co znamená zkratka USB v názvu kategorie „Kontejnery USB“?",o:["univerzální skladovací bedna","ultra silná bedna","univerzální stohovatelný box"],c:0,e:"Univerzální skladovací bedna (kap. 2.8)."},
 {q:"Čím se liší skládací kontejnery řady FCB od řady FCA?",o:["vyšší nosností podlahy","integrovanou záchytnou vanou (pro oleje a hořlaviny s bodem vzplanutí nad 100 °C)","hliníkovou konstrukcí"],c:1,e:"FCB má integrovanou záchytnou vanu 202/275 l (kap. 2.3)."},
 {q:"Zákazník exportuje do zámoří a zdržují ho fytosanitární formality u dřevěných palet. Jaký argument použijete?",o:["plastové palety LP mají vždy vyšší nosnost než dřevěné","dřevěné palety lze ošetřit postřikem přímo ve skladu","plastové palety nepodléhají ošetření ISPM-15, formality odpadají"],c:2,e:"Plastové palety nepodléhají ošetření ISPM-15 (kap. 2.7)."},
 {q:"Zákazník potřebuje šetrně vysypávat sklo do vysokého velkoobjemového kontejneru bez naklápění. Kterou řadu výklopných kontejnerů doporučíte?",o:["AMC — automatický výklop","VBB — kontejner s otevíracím dnem","VS — lopatový kontejner"],c:1,e:"VBB sype otevřením dna, materiál nepadá z výšky (kap. 2.9)."},
 {q:"Jak velký záchytný objem musí mít vana pod jedním 1000l IBC kontejnerem (dle oborové praxe)?",o:["alespoň objem největší skladované nádoby, tedy 1 000 l — vana NPIBC (1 120 l) vyhoví","10 % objemu nádoby, tedy 100 l","dvojnásobek objemu, tedy 2 000 l"],c:0,e:"Vana musí pojmout objem největší nádoby — NPIBC s 1 120 l vyhoví (kap. 2.4)."},
 {q:"Proč nelze požár Li-Ion baterie „udusit“ (pěnou, CO₂, práškem)?",o:["protože hoří při příliš nízké teplotě","protože si článek rozkladem katodového materiálu uvolňuje vlastní kyslík","protože plameny hoří jen uvnitř obalu"],c:1,e:"Článek si rozkladem katodového materiálu uvolňuje vlastní kyslík (kap. 3.4)."},
 {q:"Jaká je nejúčinnější obrana proti požáru Li-Ion baterií?",o:["práškový hasicí přístroj ABC","hasicí přístroj CO₂","masivní chlazení velkým množstvím vody, případně speciální hasiva (AVD, F-500, hasicí granulát)"],c:2,e:"Masivní chlazení vodou + speciální hasiva; prášek a CO₂ článek neuhasí (kap. 3.4, 4.5)."},
 {q:"Jaký volný odstup od budov doporučuje metodika GŘ HZS ČR pro venkovní kontejnerové skladování baterií?",o:["minimálně 5 m","minimálně 1 m","minimálně 15 m"],c:0,e:"5 m volného prostoru okolo kontejneru (kap. 4.3)."},
 {q:"Jaký stav nabití (SOC) se doporučuje pro dlouhodobé skladování Li-Ion baterií?",o:["100 % — plně nabité","cca 30–50 %","0 % — zcela vybité"],c:1,e:"30–50 % SOC (kap. 4.5)."},
 {q:"Co je ADR?",o:["evropská norma pro konstrukci obalů","Dohoda o mezinárodní silniční přepravě nebezpečných věcí (sjednaná v Ženevě 1957, spravovaná EHK OSN)","česká vyhláška o skladování nebezpečných látek"],c:1,e:"Dohoda UNECE, Ženeva 1957; aktuálně platí ADR 2025 (kap. 5.1)."},
 {q:"Do které třídy nebezpečnosti ADR patří lithiové baterie (UN 3480)?",o:["třída 4.3","třída 8","třída 9"],c:2,e:"Třída 9, bezpečnostní značka 9A; kovové lithium jako surovina je 4.3 (kap. 5.2, 5.3)."},
 {q:"Pro jaké Li-Ion baterie platí úleva SP 188?",o:["články do 20 Wh a baterie do 100 Wh, kus do 30 kg brutto","všechny baterie do 300 Wh","baterie do 1 000 Wh, kus do 50 kg"],c:0,e:"20 Wh článek / 100 Wh baterie / 30 kg kus (kap. 5.8)."},
 {q:"Co znamená podlimitní přeprava dle 1.1.3.6 pro UN 3480?",o:["do 1 000 kg bez jakýchkoli povinností","do 333 kg brutto na dopravní jednotku — bez ADR řidiče a oranžových tabulek, ale s UN obaly, značením kusů, dokladem a 2kg hasicím přístrojem","do 50 kg pouze pro vnitrostátní přepravu"],c:1,e:"333 kg brutto; úlevy jen z části povinností (kap. 5.8)."},
 {q:"Jak se od ADR 2025 přepravuje poškozená (např. nafouklá) trakční baterie?",o:["v režimu SP 188, pokud je lehčí než 30 kg","podlimitně, pokud je do 333 kg","vždy v plném režimu — SP 376, obaly P908/LP904 (kriticky poškozená jen P911/LP906 se schválením), přepravní kategorie 0 dle SP 677"],c:2,e:"SP 376 + SP 677 = vždy přepravní kategorie 0, žádný podlimit (kap. 5.10)."},
 {q:"Kdo musí mít od 1. 1. 2023 jmenovaného bezpečnostního poradce DGSA?",o:["pouze dopravci","kromě dopravců i odesílatelé (mimo režim výjimek — jen podlimitní přepravy či SP 188)","pouze příjemci zásilek"],c:1,e:"Povinnost rozšířena na odesílatele od 1. 1. 2023 (kap. 5.9)."},
 {q:"Co dokáže hasicí deka přehozená přes hořící elektromobil?",o:["definitivně uhasí požár baterie, další zásah není nutný","potlačí plameny, kouř a šíření požáru — článek ale může pod dekou dál reagovat, nutný dozor a chlazení","na elektromobily se hasicí deky nesmí používat"],c:1,e:"Deka omezí šíření, kouř a sálání; článek si vyrábí vlastní kyslík — dozor a chlazení nutné (kap. 4.6)."},
 {q:"Čím se bezpečnostní (nabíjecí) skříň na baterie typu „F90“ liší od běžné plechové skříně?",o:["silnějším plechem a vyšší nosností polic","požární odolností 90 minut zevnitř i zvenku, ventilací, detekcí a volitelným vestavěným hašením","je určena výhradně pro kovové lithium jako surovinu"],c:1,e:"90 minut odolnosti zevnitř i vně, ventilace, detekce, opce hašení — např. LOXXER (kap. 2.2, 4.6)."}
];
var PASS = 14, TESTIDX = 6;
var LETTERS = ["a","b","c","d"];
var done = {}, cur = -1, bestScore = null;

/* ---------- napojení na intranet: identita + limit 3 pokusů + odeslání výsledku ---------- */
var PRUM = { email:"", name:"", attemptsUsed:0, locked:false };
(function(){ try{ var h=location.hash||""; var me=(h.match(/kdo=([^&]+)/i)||[])[1]; var nm=(h.match(/jmeno=([^&]+)/i)||[])[1]; if(me) PRUM.email=decodeURIComponent(me); if(nm) PRUM.name=decodeURIComponent(nm); }catch(e){} })();
function setAtt(t){ var el=document.getElementById("attInfo"); if(el) el.textContent=t; }
function lockTest(){ PRUM.locked=true; var b=document.getElementById("qeval"); if(b){ b.disabled=true; b.style.opacity=".5"; b.style.cursor="not-allowed"; } var rb=document.getElementById("qretry"); if(rb){ rb.disabled=true; rb.style.opacity=".5"; rb.style.cursor="not-allowed"; } }
async function loadPrumStatus(){
  if(!PRUM.email){ setAtt("Test lze vyhodnotit, ale bez přihlášení se výsledek neuloží."); return; }
  try{
    var j=await (await fetch("/api/prumysl?email="+encodeURIComponent(PRUM.email),{cache:"no-store"})).json();
    PRUM.attemptsUsed=(j&&j.attemptsUsed)||0;
    if(PRUM.attemptsUsed>=3){ lockTest(); setAtt("Vyčerpal(a) jste všechny 3 pokusy"+(j&&j.best?(" · nejlepší výsledek "+j.best+" %"):"")+"."); }
    else setAtt(PRUM.attemptsUsed>0 ? ("Využito pokusů: "+PRUM.attemptsUsed+" / 3"+(j&&j.best?(" · nejlepší "+j.best+" %"):"")) : "Máte 3 pokusy na splnění testu (hranice 80 %). Výsledek se ukládá vedení.");
  }catch(e){ setAtt("Máte 3 pokusy na splnění testu (hranice 80 %)."); }
}

var $ = function(s,el){ return (el||document).querySelector(s); };
var $$ = function(s,el){ return Array.prototype.slice.call((el||document).querySelectorAll(s)); };

/* ---------- nav ---------- */
function buildNav(){
  var nav = $("#nav");
  var h = '<div class="ntitle">Obsah školení</div>';
  h += '<button class="ni" data-i="-1"><span class="no">◈</span><span class="tt">Titulní přehled</span><span class="ok">✓</span></button>';
  NAV.forEach(function(s,i){
    h += '<button class="ni" data-i="'+i+'"><span class="no">'+s.num+'</span><span class="tt">'+s.title+'</span>'+
      (i===TESTIDX && bestScore!==null ? '<span class="sc">'+bestScore+'/'+QUIZ.length+'</span>' : '')+
      '<span class="ok">✓</span></button>';
    if(i===cur && s.subs.length){
      h += '<div class="subnav">'+s.subs.map(function(sb){
        return '<button class="sn" data-i="'+i+'" data-id="'+sb.id+'">'+sb.t+'</button>';
      }).join("")+'</div>';
    }
  });
  nav.innerHTML = h;
  $$(".ni",nav).forEach(function(b){
    var i = +b.dataset.i;
    if(i===cur) b.classList.add("act");
    if(done[i]) b.classList.add("done");
    b.onclick = function(){ show(i); };
  });
  $$(".sn",nav).forEach(function(b){
    b.onclick = function(){
      show(+b.dataset.i);
      var el = document.getElementById(b.dataset.id);
      if(el){ el.scrollIntoView({behavior:"smooth",block:"start"}); }
      closeSb();
    };
  });
}

function buildCards(){
  $("#cards").innerHTML = NAV.map(function(s,i){
    return '<button class="card'+(done[i]?" done":"")+'" data-i="'+i+'">'+
      '<span class="cn">Kapitola '+s.num+'</span><span class="ct">'+s.title+'</span>'+
      '<span class="cm"><span>'+(i===TESTIDX ? QUIZ.length+" otázek" : (s.subs.length ? s.subs.length+" podkapitol" : "souhrn"))+'</span>'+
      '<span class="st">'+(i===TESTIDX && bestScore!==null ? bestScore+"/"+QUIZ.length : "prostudováno")+'</span></span></button>';
  }).join("");
  $$("#cards .card").forEach(function(c){ c.onclick = function(){ show(+c.dataset.i); }; });
}

function progress(){
  var n = Object.keys(done).length;
  $("#pfill").style.width = (n/NAV.length*100)+"%";
  $("#ptext").textContent = n+" z "+NAV.length;
}

function markDone(i){ if(i>=0 && !done[i]){ done[i]=1; progress(); } }

function show(i){
  cur = i;
  $$(".view,.hero").forEach(function(v){ v.classList.remove("act"); });
  var el = i<0 ? $("#home") : $("#sec-"+i);
  el.classList.add("act");
  $("#crumb").innerHTML = i<0 ? "<b>Školení Průmysl</b> · titulní přehled"
    : "Kapitola "+NAV[i].num+" · <b>"+NAV[i].title+"</b>";
  buildNav(); if(i<0) buildCards();
  closeSb();
  window.scrollTo({top:0});
  document.querySelector(".wrap").scrollTop = 0;
}

/* bottom prev/next */
function buildBnavs(){
  NAV.forEach(function(s,i){
    var d = document.createElement("div");
    d.className = "bnav";
    var prev = document.createElement("button");
    prev.className = "btn ghost";
    prev.textContent = i===0 ? "← Titulní přehled" : "← Kapitola "+NAV[i-1].num;
    prev.onclick = function(){ show(i===0 ? -1 : i-1); };
    var next = document.createElement("button");
    next.className = "btn";
    if(i===NAV.length-1){ next.textContent = "Dokončit školení"; next.onclick = function(){ markDone(i); show(-1); }; }
    else { next.textContent = "Další kapitola →"; next.onclick = function(){ markDone(i); show(i+1); }; }
    d.appendChild(prev); d.appendChild(next);
    $("#sec-"+i).appendChild(d);
  });
}

/* ---------- quiz ---------- */
function buildQuiz(){
  var host = $("#quiz");
  var h = '<div class="qres" id="qres"><div class="big" id="qscore"></div><div class="vt" id="qverdict"></div></div><div class="qz" id="qz">';
  QUIZ.forEach(function(item,qi){
    h += '<div class="qcard" id="qc'+qi+'"><p class="qq"><span class="qn">'+(qi+1)+'.</span> '+item.q+'</p>';
    item.o.forEach(function(op,oi){
      h += '<label class="opt" data-q="'+qi+'" data-o="'+oi+'"><input type="radio" name="q'+qi+'" value="'+oi+'">'+
        '<span class="ol">'+LETTERS[oi]+')</span><span>'+op+'</span></label>';
    });
    h += '<div class="qexpl" id="qe'+qi+'"></div></div>';
  });
  h += '</div><div class="qactions"><button class="btn" id="qeval">Vyhodnotit test</button>'+
    '<button class="btn ghost" id="qretry" style="display:none">Zkusit znovu</button>'+
    '<span class="qmsg" id="qmsg"></span></div>';
  host.innerHTML = h;
  $("#qeval").onclick = evalQuiz;
  $("#qretry").onclick = resetQuiz;
}

function evalQuiz(){
  if(PRUM.locked) return;
  var missing = [];
  QUIZ.forEach(function(item,qi){
    $("#qc"+qi).classList.remove("miss");
    if(!$('input[name="q'+qi+'"]:checked')) missing.push(qi);
  });
  var msg = $("#qmsg");
  if(missing.length){
    missing.forEach(function(qi){ $("#qc"+qi).classList.add("miss"); });
    msg.textContent = "Zbývá zodpovědět: "+missing.length+" "+(missing.length===1?"otázka":(missing.length<5?"otázky":"otázek"))+".";
    msg.classList.add("show");
    $("#qc"+missing[0]).scrollIntoView({behavior:"smooth",block:"center"});
    return;
  }
  msg.classList.remove("show");
  var score = 0;
  QUIZ.forEach(function(item,qi){
    var pick = +$('input[name="q'+qi+'"]:checked').value;
    var ok = pick===item.c;
    if(ok) score++;
    $$('.opt[data-q="'+qi+'"]').forEach(function(o){
      var oi = +o.dataset.o;
      if(oi===item.c) o.classList.add("good");
      else if(oi===pick) o.classList.add("badpick");
    });
    var ex = $("#qe"+qi);
    ex.innerHTML = (ok ? "Správně. " : "Správná odpověď: <strong>"+LETTERS[item.c]+")</strong> ")+item.e;
    ex.className = "qexpl show"+(ok?"":" bad");
  });
  $("#qz").classList.add("locked");
  $("#qeval").style.display = "none";
  $("#qretry").style.display = "";
  bestScore = (bestScore===null) ? score : Math.max(bestScore,score);
  var res = $("#qres");
  res.className = "qres show"+(score>=PASS?"":" fail");
  $("#qscore").textContent = "Vaše skóre: "+score+" z "+QUIZ.length;
  $("#qverdict").textContent = score>=16 ? "Výborně — jste připraveni na zákazníky."
    : score>=PASS ? "Dobrý výsledek. Projděte si kapitoly u otázek, kde jste chybovali."
    : "Pod doporučenou hranicí ("+PASS+" ze "+QUIZ.length+"). Vraťte se ke kapitolám 4 a 5 — právě tam se rozhoduje o důvěryhodnosti obchodníka v tomto segmentu.";
  if(score>=PASS) markDone(TESTIDX);
  buildNav();
  res.scrollIntoView({behavior:"smooth",block:"center"});
  // odeslání výsledku do intranetu (upsert dle e-mailu, max 3 pokusy, hranice 80 %)
  var pct = Math.round(score/QUIZ.length*100);
  if(PRUM.email && !PRUM.locked){
    fetch("/api/prumysl",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email:PRUM.email,name:PRUM.name,correct:score,total:QUIZ.length,pct:pct,passed:pct>=80})})
      .then(function(r){return r.json();}).then(function(j){
        if(j&&j.blocked){ PRUM.attemptsUsed=3; lockTest(); setAtt("Vyčerpal(a) jste všechny 3 pokusy — tento výsledek se už neuložil."); }
        else if(j&&j.ok){ PRUM.attemptsUsed=j.attempt; if(j.attemptsLeft<=0){ lockTest(); setAtt("Pokusy vyčerpány (3/3)."); } else setAtt("Využito pokusů: "+PRUM.attemptsUsed+" / 3 · zbývají "+j.attemptsLeft+"."); }
      }).catch(function(){});
  }
}

function resetQuiz(){
  if(PRUM.locked) return;
  buildQuiz();
  if(PRUM.locked) lockTest();
  $("#sec-"+TESTIDX).scrollIntoView({behavior:"smooth",block:"start"});
  window.scrollTo({top:0});
}

/* ---------- search ---------- */
var IDX = [];
function norm(s){ return s.normalize("NFD").replace(/[̀-ͯ]/g,"").toLowerCase(); }
function buildIndex(){
  NAV.forEach(function(s,i){
    $$("#sec-"+i+" p, #sec-"+i+" li, #sec-"+i+" td, #sec-"+i+" h2, #sec-"+i+" h3").forEach(function(el){
      var t = el.textContent.trim();
      if(t.length>2) IDX.push({i:i,el:el,t:t,n:norm(t)});
    });
  });
}
function doSearch(){
  var q = $("#q").value.trim();
  var res = $("#res");
  if(q.length<3){ res.classList.remove("on"); res.innerHTML=""; return; }
  var nq = norm(q), out = [];
  for(var k=0;k<IDX.length && out.length<20;k++){
    var pos = IDX[k].n.indexOf(nq);
    if(pos>-1) out.push({r:IDX[k],pos:pos});
  }
  if(!out.length){ res.innerHTML = '<div class="none">Nic nenalezeno pro „'+q.replace(/</g,"&lt;")+'“.</div>'; res.classList.add("on"); return; }
  res.innerHTML = out.map(function(m,mi){
    var t = m.r.t, a = Math.max(0,m.pos-40), b = Math.min(t.length,m.pos+q.length+60);
    var snip = (a>0?"…":"")+t.slice(a,m.pos)+"<mark>"+t.slice(m.pos,m.pos+q.length)+"</mark>"+t.slice(m.pos+q.length,b)+(b<t.length?"…":"");
    return '<div class="ri" data-m="'+mi+'"><b class="k">Kapitola '+NAV[m.r.i].num+' · '+NAV[m.r.i].title+'</b>'+snip+'</div>';
  }).join("");
  res.classList.add("on");
  $$(".ri",res).forEach(function(r){
    r.onmousedown = function(ev){
      ev.preventDefault();
      var m = out[+r.dataset.m];
      show(m.r.i);
      setTimeout(function(){
        m.r.el.scrollIntoView({behavior:"smooth",block:"center"});
        m.r.el.classList.remove("flash"); void m.r.el.offsetWidth; m.r.el.classList.add("flash");
      },60);
      res.classList.remove("on");
      $("#q").value = "";
    };
  });
}

/* ---------- sidebar (mobile) ---------- */
function closeSb(){ $("#sb").classList.remove("open"); $("#ovl").classList.remove("on"); }
$("#burger").onclick = function(){ $("#sb").classList.add("open"); $("#ovl").classList.add("on"); };
$("#ovl").onclick = closeSb;

/* ---------- init ---------- */
var st = null;
$("#q").addEventListener("input", function(){ clearTimeout(st); st = setTimeout(doSearch,140); });
$("#q").addEventListener("blur", function(){ setTimeout(function(){ $("#res").classList.remove("on"); },150); });
document.addEventListener("keydown", function(e){
  if(e.target.tagName==="INPUT" || e.target.tagName==="TEXTAREA") return;
  if(e.key==="ArrowRight" && cur<NAV.length-1) show(cur+1);
  if(e.key==="ArrowLeft" && cur>-1) show(cur-1);
});
$("#startBtn").onclick = function(){ show(0); };
$("#testBtn").onclick = function(){ show(TESTIDX); };

buildQuiz();
buildBnavs();
buildIndex();
progress();
show(-1);
loadPrumStatus();
</script>
</body>
</html>
